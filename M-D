[Unit]
Description=DBA AI Agent - FastAPI Web API
After=network.target

[Service]
Type=simple

WorkingDirectory=/home/test/opt/os-agent

EnvironmentFile=/home/test/opt/os-agent/.oracle.env

ExecStart=/home/test/opt/os-agent/venv/bin/uvicorn core.fastapi_app:app --host 0.0.0.0 --port 8801

Restart=always
RestartSec=5

User=root

[Install]
WantedBy=multi-user.target
