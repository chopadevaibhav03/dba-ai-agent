{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python3",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.testing.pytestEnabled": false,
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "venv": false
  },
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/metrics.db": true,
    "**/reports/**": true,
    "**/scans/**": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/__pycache__": true,
    "**/reports": true,
    "**/scans": true
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  }
}
