:root {
  --bg: #f5f5f4;
  --surface: #ffffff;
  --border: #e3e2df;
  --text: #1f1e1c;
  --text-muted: #6b6a66;
  --accent: #185fa5;
  --accent-hover: #0c447c;
  --danger: #a32d2d;
  --warning: #854f0b;
  --success: #3b6d11;
  --radius: 10px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1a1a18;
    --surface: #242422;
    --border: #3a3a37;
    --text: #ece9e2;
    --text-muted: #a3a199;
    --accent: #85b7eb;
    --accent-hover: #b5d4f4;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

.app { max-width: 900px; margin: 0 auto; padding: 24px 20px 60px; }

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

h1 { font-size: 22px; font-weight: 500; margin: 0 0 4px; }
h2 { font-size: 16px; font-weight: 500; margin: 0; }
.subtitle { margin: 0; color: var(--text-muted); font-size: 13px; }

.tabs { display: flex; gap: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 4px; }
.tab-btn {
  border: none; background: transparent; padding: 8px 16px; border-radius: 6px;
  cursor: pointer; font-size: 14px; color: var(--text-muted);
}
.tab-btn.active { background: var(--accent); color: #fff; }

.tab-panel { display: none; }
.tab-panel.active { display: block; }

.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
.metric-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 16px; display: flex; flex-direction: column; gap: 6px;
}
.metric-label { font-size: 12px; color: var(--text-muted); }
.metric-value { font-size: 24px; font-weight: 500; }

.card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
  padding: 16px 20px; margin-bottom: 16px;
}
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }

.btn {
  border: none; border-radius: 8px; padding: 8px 16px; font-size: 14px;
  cursor: pointer; font-weight: 500;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-hover); }
.btn-secondary { background: var(--border); color: var(--text); }

.muted { color: var(--text-muted); font-size: 14px; }

.severity-badge {
  display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 500;
  margin-right: 8px;
}
.sev-critical { background: #fcebeb; color: var(--danger); }
.sev-warning { background: #faeeda; color: var(--warning); }
.sev-info { background: #eaf3de; color: var(--success); }

.action-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 0; border-top: 1px solid var(--border); gap: 12px;
}
.action-row code { font-size: 12px; background: var(--bg); padding: 2px 6px; border-radius: 4px; }

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
th { color: var(--text-muted); font-weight: 500; }

.chat-hint { margin-bottom: 12px; }
.chat-log {
  background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
  padding: 16px; min-height: 360px; max-height: 60vh; overflow-y: auto; margin-bottom: 12px;
  display: flex; flex-direction: column; gap: 10px;
}
.msg { max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 14px; line-height: 1.5; }
.msg-user { align-self: flex-end; background: var(--accent); color: #fff; }
.msg-assistant { align-self: flex-start; background: var(--bg); border: 1px solid var(--border); }
.msg-confirm { align-self: flex-start; background: var(--bg); border: 1px solid var(--warning); }
.confirm-actions { display: flex; gap: 8px; margin-top: 10px; }

.chat-input-row { display: flex; gap: 8px; }
#chat-input {
  flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text); font-size: 14px;
}

@media (max-width: 640px) {
  .metric-grid { grid-template-columns: repeat(2, 1fr); }
}
