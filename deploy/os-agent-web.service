# systemd unit for the OS monitoring agent web API (Gunicorn + Flask).
#
# Install:
#   sudo cp os-agent-web.service /etc/systemd/system/os-agent-web.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now os-agent-web
#   sudo systemctl status os-agent-web

[Unit]
Description=OS monitoring agent - web API 
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/test/opt/os-agent
ExecStart=/home/test/opt/os-agent/venv/bin/uvicorn core.fastapi_app:app --host 0.0.0.0 --port 8801
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
